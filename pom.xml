<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.motorfraude</groupId>
        <artifactId>motor-fraude-parent</artifactId>
        <version>0.1.0</version>
        <relativePath/>
    </parent>

    <artifactId>platform-streams</artifactId>
    <name>platform-streams</name>
    <description>Base dos apps Kafka Streams: bootstrap com EOS e static membership, servidor HTTP de saúde e métricas (sem Spring).</description>

    <dependencies>
        <dependency>
            <groupId>br.com.motorfraude</groupId>
            <artifactId>platform-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Exceção à regra "sem Jackson 2": o kafka-streams usa o jackson-databind 2 em tempo de execução (só a
                     StateDirectory, mas ela roda na partida de todo app com estado). Só no escopo runtime: ele fica fora do
                     classpath de compilação, então o nosso código não consegue importá-lo. Decisão do usuário (plano 003). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-platform</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <includes>
                                        <include>com.fasterxml.jackson.core:jackson-databind:*:jar:runtime</include>
                                        <include>com.fasterxml.jackson.core:jackson-core:*:jar:runtime</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/*</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/platform-streams</url>
        </repository>
    </distributionManagement>
</project>
